{
  "description": "Creates ~/.config/session-archive/config.json (every key at its default) on first run. Silent; never overwrites a file.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/session-archive\" seed --quiet; python \"${CLAUDE_PLUGIN_ROOT}/bin/session-archive\" seed --quiet; exit 0",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
